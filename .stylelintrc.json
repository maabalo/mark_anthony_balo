{
  "extends": "stylelint-config-standard",
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      { "message": "Use kebab-case, optionally BEM (block__element--modifier)" }
    ],
    "value-keyword-case": [
      "lower",
      { "camelCaseSvgKeywords": true, "ignoreProperties": ["/^--font-/", "font-family"] }
    ]
  }
}
